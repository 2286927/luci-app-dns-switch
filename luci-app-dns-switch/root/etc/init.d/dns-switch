#!/bin/sh /etc/rc.common
# /etc/init.d/dns-switch
# DNS 一键切换的常驻守护。每 55 秒跑一次 tick，负责：
#   - mode=on 时探测 ADH，连续失败 2 次自动降级到运营商
#   - ADH 恢复后连续成功 3 次自动回切（带 120 秒冷却）
#   - 修补漂移（上游被改、nft 链丢失、option 6 被改）
#   - 每轮顺手检查 853 是否被人重新拦上

USE_PROCD=1
START=99
STOP=10

start_service() {
	procd_open_instance dns-switch
	procd_set_param command /usr/bin/dns-switch daemon
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	# 必须放在 service_triggers 里，procd 会在 start_service 之后单独调用它。
	# 放进 start_service 里注册不上（实测 triggers 是空数组）。
	# 只监听 dns_switch 这一个配置；脚本内部的 shell uci commit 不产生
	# config.change 事件，所以不会自己触发自己。
	procd_add_reload_trigger "dns_switch"
}

reload_service() {
	# 必须后台化。apply-intent 里包含探测（最长 6 秒）、fw4 reload、
	# dnsmasq 重启和自检，同步执行会把 rpcd 的 uci apply 卡住 20 秒以上，
	# 占满 uhttpd 的 CGI 槽（就是之前 LuCI 全站卡死的那个坑）。
	( /usr/bin/dns-switch apply-intent >/dev/null 2>&1 & )
}
